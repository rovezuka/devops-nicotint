{
  "uid": "shop-overview",
  "title": "shop — обзор",
  "tags": [
    "shop",
    "lab3"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1. Ошибки API (5xx)",
      "description": "Доля 5xx среди пользовательских запросов (без проб /health) и число ошибок в секунду. Первая панель при ShopAPIHighErrorRate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(http_requests_total{namespace=\"shop\",handler!=\"health\",code=~\"5..\"}[2m])) or vector(0)) / sum(rate(http_requests_total{namespace=\"shop\",handler!=\"health\"}[2m]))",
          "legendFormat": "доля 5xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (handler) (rate(http_requests_total{namespace=\"shop\",handler!=\"health\",code=~\"5..\"}[2m]))",
          "legendFormat": "5xx/с {{{{handler}}}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "2. Latency API, p95",
      "description": "95-й перцентиль времени ответа пользовательских запросов. by (le) обязателен: histogram_quantile нужны все бакеты.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"shop\",handler!=\"health\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "3. Traffic API (RPS)",
      "description": "Запросы в секунду по эндпоинту и коду ответа (включая пробы health).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (handler, code) (rate(http_requests_total{namespace=\"shop\"}[1m]))",
          "legendFormat": "{{handler}} {{code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4. Заказы: очередь и обработка worker",
      "description": "Ожидающие заказы (max: каждый worker отдаёт общее число из БД, sum удвоил бы), скорость обработки и секунды с последней успешной итерации.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(shop_worker_pending_orders{namespace=\"shop\"})",
          "legendFormat": "ожидают"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(shop_worker_orders_processed_total{namespace=\"shop\"}[5m]))",
          "legendFormat": "обработано/с"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "time() - max(shop_worker_last_success_timestamp_seconds{namespace=\"shop\"})",
          "legendFormat": "с последнего успеха, с"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5. Реплики: желаемые vs доступные",
      "description": "Связь с ShopWorkerUnavailable: доступных меньше желаемых — часть подов не готова; 0 доступных — сервис стоит.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "kube_deployment_spec_replicas{namespace=\"shop\",deployment=~\"shop-(api|worker)\"}",
          "legendFormat": "{{deployment}} желаемые"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "kube_deployment_status_replicas_available{namespace=\"shop\",deployment=~\"shop-(api|worker)\"}",
          "legendFormat": "{{deployment}} доступные"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "6. Память подов vs лимит",
      "description": "Working set памяти подов api/worker и лимит из kube-state-metrics. В minikube (docker + cri-dockerd) cAdvisor отдаёт только уровень пода, без метки container.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "container_memory_working_set_bytes{namespace=\"shop\",pod=~\"shop-(api|worker)-.*\"}",
          "legendFormat": "{{pod}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"shop\",container=~\"api|worker\",resource=\"memory\",unit=\"byte\"})",
          "legendFormat": "лимит"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "7. CPU подов",
      "description": "Потребление CPU подами api/worker (ядер). Лимита по CPU нет сознательно (см. политику require-resources), request = 0.1 ядра.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"shop\",pod=~\"shop-(api|worker)-.*\"}[5m])",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}